# ---------------------------------------------------------------------------
# Rust workspace (promoted from ainb-tui/.gitignore when the workspace moved
# to the repository root).
# ---------------------------------------------------------------------------

/target/
# Cargo.lock IS tracked. `ainb` ships as a binary, so the lock is what makes a
# build reproducible, and CI has no other pin: without it every run re-resolves
# the whole graph and inherits whatever the ecosystem published that hour. That
# is not hypothetical: zune-core 0.5.2 (2026-08-07) broke zune-jpeg 0.5.15, and
# every macOS job went red on a dependency nobody here had touched.
*.rs.bk
*.pdb
*.swp
*.swo
*~
Thumbs.db

# CTS canary artifacts: built on demand via `cargo xtask build-canaries`
crates/ainb-plugin-host/tests/cts/canaries/target/
crates/ainb-plugin-host/tests/cts/fixtures/

# ainb-plugin-burndown is a sub-workspace cdylib; its target lives under
# its own crate dir, separate from the root /target. Built via
# ./scripts/build-plugins.sh (sources scripts/wasi-env.sh).
crates/ainb-plugin-burndown/target/
# Session-reader is also a sub-workspace cdylib (Phase 6b).
crates/ainb-plugin-session-reader/target/
crates/ainb-plugin-session-reader/Cargo.lock
crates/ainb-plugin-session-reader/logs/
# Staged plugin .wasm artifacts (output of scripts/build-plugins.sh)
dist/plugins/

